# ── Supabase ────────────────────────────────────────────────────────────────
# Dasselbe Projekt wie Anmelde-Tool und Kursportal (Tabellen mit Präfix live_).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Nur serverseitig: Teilnahme- und Beamer-Routen, Konten anlegen.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://live.weprompt.ch
# Salz für den IP-Hash im Rate Limit (beliebiger langer Zufallswert).
RATE_LIMIT_SALT=change-me-use-a-long-random-string

# ── E-Mail (Resend, Domain weprompt.ch ist verifiziert) ──────────────────────
RESEND_API_KEY=re_your_key
LIVE_FROM_EMAIL="WePrompt Live <live@weprompt.ch>"
